# Vercel Blob Storage Configuration
# Get these values from your Vercel dashboard after setting up Blob Storage

# Vercel Blob Store ID (found in your Vercel dashboard under Storage > Blob)
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token_here

# Optional: Vercel Blob Store ID (if you want to specify a specific store)
# BLOB_STORE_ID=your_store_id_here
