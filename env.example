# Vercel Blob Storage Configuration
# Get these values from your Vercel dashboard after setting up Blob Storage

# Vercel Blob Store ID (found in your Vercel dashboard under Storage > Blob)
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token_here

# Optional: Vercel Blob Store ID (if you want to specify a specific store)
# BLOB_STORE_ID=your_store_id_here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/ecommerce-shop
# OR for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ecommerce-shop

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Next.js Configuration
NEXT_PUBLIC_MONGODB_URI=mongodb://localhost:27017/ecommerce-shop